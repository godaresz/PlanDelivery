rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these accounts can upload / edit rules / export / delete. Add more emails to the list.
    // Also turn OFF self sign-up: Firebase console > Authentication > Settings > User actions > "Enable create (sign-up)".
    function isEditor() {
      return request.auth != null && request.auth.token.email in ['admin@delivery.co'];
    }
    match /shipcheck/{docId} {
      // Anyone with the link can view. To require login for viewing too,
      // change the next line to:  allow read: if request.auth != null;
      allow read: if true;
      allow write: if isEditor();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
