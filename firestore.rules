rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these accounts can upload / edit rules / export / delete. Add more emails to the list.
    // Also turn OFF self sign-up: Firebase console > Authentication > Settings > User actions > "Enable create (sign-up)".
    function isEditor() {
      return request.auth != null && request.auth.token.email in ['admin@delivery.co'];
    }
    // upload history holds editors' emails: signed-in users only
    match /shipcheck/uploadlog {
      allow get: if request.auth != null;
      allow write: if isEditor();
    }
    match /shipcheck/{docId} {
      // Anyone with the link can view a document (the app only reads docs by id).
      // "get" without "list": nobody can dump the whole collection with one request.
      // To require login for viewing too, change the next line to:  allow get: if request.auth != null;
      allow get: if docId != 'uploadlog';
      allow write: if isEditor();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
